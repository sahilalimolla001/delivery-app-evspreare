NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quick_commerce_rider
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=replace-with-strong-admin-key
EXTERNAL_ORDER_API_KEY=replace-with-strong-order-import-key
WAREHOUSE_API_URL=https://your-warehouse-backend.up.railway.app
WAREHOUSE_INTEGRATION_API_KEY=warehouse-integration-key
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
TRUST_PROXY=false
AUTO_MIGRATE=true
OTP_TTL_SECONDS=300
# Use dev locally. Production defaults to twilio after adding real Twilio credentials.
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_OTP_CHANNEL=sms
GOOGLE_MAPS_API_KEY=replace-me
S3_BUCKET=quick-commerce-rider-documents
FCM_SERVER_KEY=replace-me
