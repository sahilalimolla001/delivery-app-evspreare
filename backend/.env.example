NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quick_commerce_rider
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
TRUST_PROXY=false
OTP_TTL_SECONDS=300
# Use dev locally. Set OTP_PROVIDER=twilio in production after adding real Twilio credentials.
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_OTP_CHANNEL=sms
GOOGLE_MAPS_API_KEY=replace-me
S3_BUCKET=quick-commerce-rider-documents
FCM_SERVER_KEY=replace-me
